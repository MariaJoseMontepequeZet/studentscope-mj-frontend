# Copia este archivo como despliegue/.env y completa los valores. El archivo .env no se sube al repositorio.
DB_NAME=studentscope_mj
DB_USER=studentscope
DB_PASSWORD=pon-aqui-una-clave-larga
# Al menos 32 caracteres. Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=pon-aqui-otra-clave-de-mas-de-32-caracteres
# Opcional: se crea este administrador la primera vez
ADMIN_EMAIL=admin@ejemplo.com
ADMIN_PASSWORD=Cambia123456
# true carga 35 estudiantes de ejemplo si la tabla esta vacia
SEMBRAR_EJEMPLO=true
DEMO_HABILITADA=false
